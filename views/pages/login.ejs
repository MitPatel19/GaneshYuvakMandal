<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#8e1b3a">
<title><%= title %> · <%= settings.mandal_name %></title>
<link rel="stylesheet" href="/css/style.css">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="manifest" href="/manifest.webmanifest">
</head>
<body>
<div class="login-wrap">
  <form class="login-card" method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">

    <div class="login-card__logo">🕉</div>
    <h1><%= settings.mandal_name %></h1>
    <p class="login-card__sub"><%= t('login_title') %></p>

    <% if (error) { %>
      <div class="alert alert--err" role="alert">
        <span class="alert__ic">⚠️</span><span><%= error %></span>
      </div>
    <% } %>

    <div class="field">
      <label for="username"><%= t('username') %></label>
      <input type="text" id="username" name="username" autocomplete="username"
             autocapitalize="none" autocorrect="off" required autofocus>
    </div>

    <div class="field">
      <label for="password"><%= t('password') %></label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
    </div>

    <button class="btn btn--primary btn--block btn--lg" type="submit"><%= t('login') %> →</button>

    <hr class="divider">
    <div class="center">
      <a class="btn btn--ghost btn--sm" href="/p">🌐 <%= t('public_page') %></a>
    </div>
    <p class="center faint small mt-2">Ganpati Bappa Morya 🙏</p>
  </form>
</div>

<div class="container-narrow" style="padding-bottom:20px">
  <%- include('../partials/credit') %>
</div>
<script src="/js/app.js" defer></script>
</body>
</html>
