<%- include('../partials/header') %>

<div class="pagehead">
  <h1>👤 <%= title %></h1>
  <div class="pagehead__actions"><a class="btn btn--ghost" href="/members">← <%= t('back') %></a></div>
</div>

<form method="post" action="<%= action %>" class="container-narrow">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card">
    <div class="field">
      <label for="name"><%= t('name') %> *</label>
      <input type="text" id="name" name="name" value="<%= member.name %>" required autofocus>
    </div>

    <div class="formgrid">
      <div class="field">
        <label for="phone"><%= t('phone') %></label>
        <input type="tel" id="phone" name="phone" value="<%= member.phone %>" inputmode="tel"
               placeholder="98765 43210">
        <div class="field__hint">Used for WhatsApp and calling.</div>
      </div>
      <div class="field">
        <label for="role"><%= t('role') %></label>
        <select id="role" name="role">
          <% roles.forEach(function(r){ %>
            <option value="<%= r %>" <%= member.role === r ? 'selected' : '' %>><%= r %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="field">
      <label for="address"><%= t('address') %></label>
      <input type="text" id="address" name="address" value="<%= member.address %>">
    </div>

    <div class="field">
      <label for="note"><%= t('note') %></label>
      <textarea id="note" name="note" style="min-height:90px"><%= member.note %></textarea>
    </div>

    <label class="check <%= member.is_active ? 'check--on' : '' %>">
      <input type="checkbox" name="is_active" value="1" <%= member.is_active ? 'checked' : '' %>>
      <span>Active member</span>
    </label>

    <div class="btnrow mt-2">
      <button class="btn btn--primary btn--lg" type="submit">💾 <%= t('save') %></button>
      <a class="btn btn--ghost" href="/members"><%= t('cancel') %></a>
    </div>
  </div>
</form>

<% if (member.id) { %>
  <form class="container-narrow" method="post" action="/members/<%= member.id %>/delete"
        data-confirm="<%= t('confirm_delete') %>" data-no-lock>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn--danger btn--sm" type="submit">🗑 <%= t('delete') %></button>
  </form>
<% } %>

<%- include('../partials/footer') %>
