<%- include('../partials/header') %>

<div class="pagehead">
  <h1>🔑 <%= t('my_account') %></h1>
</div>

<div class="container-narrow">
  <div class="card">
    <div class="flex mb-2">
      <span class="avatar" aria-hidden="true"><%= h.initials(user.display_name || user.username) %></span>
      <div>
        <div class="bold big"><%= user.display_name || user.username %></div>
        <div class="muted small">
          <%= user.username %> ·
          <span class="badge <%= isOwner ? 'badge--gold' : 'badge--info' %>">
            <%= isOwner ? t('role_owner') : t('role_helper') %>
          </span>
        </div>
      </div>
    </div>

    <% if (isOwner) { %>
      <p class="field__hint">
        <%= t('role_owner_can') %>
        <a href="/settings">⚙️ <%= t('settings') %> →</a>
      </p>
    <% } else { %>
      <p class="field__hint"><%= t('role_helper_can') %></p>
    <% } %>
  </div>

  <div class="card">
    <h3>🔐 <%= t('change_password') %></h3>
    <form method="post" action="/account/password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="current_password">Current password</label>
        <input type="password" id="current_password" name="current_password"
               autocomplete="current-password" required>
      </div>
      <div class="formgrid">
        <div class="field">
          <label for="new_password"><%= t('new_password') %></label>
          <input type="password" id="new_password" name="new_password"
                 autocomplete="new-password" minlength="6" required>
        </div>
        <div class="field">
          <label for="confirm_password">Repeat new password</label>
          <input type="password" id="confirm_password" name="confirm_password"
                 autocomplete="new-password" minlength="6" required>
        </div>
      </div>
      <button class="btn btn--primary btn--lg" type="submit">🔐 <%= t('save') %></button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
