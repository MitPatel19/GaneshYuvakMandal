<%- include('../partials/header') %>

<div class="pagehead">
  <h1>💰 <%= title %></h1>
  <div class="pagehead__actions"><a class="btn btn--ghost" href="/donations">← <%= t('back') %></a></div>
</div>

<form method="post" action="<%= action %>" class="container-narrow">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="card">
    <div class="field">
      <label for="donor_name"><%= t('donor_name') %> *</label>
      <input type="text" id="donor_name" name="donor_name" value="<%= donation.donor_name %>" required autofocus>
    </div>

    <div class="field">
      <label for="amount"><%= t('amount') %> (<%= currency %>) *</label>
      <input type="number" id="amount" name="amount" value="<%= donation.amount %>"
             min="1" step="1" inputmode="numeric" required>
      <div class="chips">
        <% quickAmounts.forEach(function(a){ %>
          <button type="button" class="chip" data-amount="<%= a %>" data-amount-target="amount"><%= currency %><%= a %></button>
        <% }); %>
      </div>
    </div>

    <div class="formgrid">
      <div class="field">
        <label for="phone"><%= t('phone') %></label>
        <input type="tel" id="phone" name="phone" value="<%= donation.phone %>" inputmode="tel" placeholder="98765 43210">
        <div class="field__hint">Needed to send the receipt on WhatsApp.</div>
      </div>
      <div class="field">
        <label for="donated_on"><%= t('date') %></label>
        <input type="date" id="donated_on" name="donated_on" value="<%= donation.donated_on %>">
      </div>
    </div>

    <div class="formgrid">
      <div class="field">
        <label for="mode"><%= t('payment_mode') %></label>
        <select id="mode" name="mode">
          <% modes.forEach(function(m){ %>
            <option value="<%= m %>" <%= donation.mode === m ? 'selected' : '' %>><%= m %></option>
          <% }); %>
        </select>
      </div>
      <div class="field">
        <label for="purpose"><%= t('purpose') %></label>
        <select id="purpose" name="purpose">
          <% purposes.forEach(function(p){ %>
            <option value="<%= p %>" <%= donation.purpose === p ? 'selected' : '' %>><%= p %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="field">
      <label for="address"><%= t('address') %></label>
      <input type="text" id="address" name="address" value="<%= donation.address %>">
    </div>

    <div class="formgrid">
      <div class="field">
        <label for="receipt_no"><%= t('receipt_no') %></label>
        <input type="text" id="receipt_no" name="receipt_no" value="<%= donation.receipt_no %>">
      </div>
      <div class="field">
        <label for="received_by"><%= t('received_by') %></label>
        <input type="text" id="received_by" name="received_by" value="<%= donation.received_by %>">
      </div>
    </div>

    <div class="field">
      <label for="note"><%= t('note') %></label>
      <textarea id="note" name="note" style="min-height:80px"><%= donation.note %></textarea>
    </div>

    <div class="btnrow mt-2">
      <button class="btn btn--primary btn--lg" type="submit">💾 <%= t('save') %> & <%= t('receipt') %></button>
      <a class="btn btn--ghost" href="/donations"><%= t('cancel') %></a>
    </div>
  </div>
</form>

<% if (donation.id) { %>
  <form class="container-narrow" method="post" action="/donations/<%= donation.id %>/delete"
        data-confirm="<%= t('confirm_delete') %>" data-no-lock>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn--danger btn--sm" type="submit">🗑 <%= t('delete') %></button>
  </form>
<% } %>

<%- include('../partials/footer') %>
