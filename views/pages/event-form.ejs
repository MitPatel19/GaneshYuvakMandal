<%- include('../partials/header') %>

<div class="pagehead">
  <h1>📅 <%= title %></h1>
  <div class="pagehead__actions"><a class="btn btn--ghost" href="/schedule">← <%= t('back') %></a></div>
</div>

<form method="post" action="<%= action %>" class="container-narrow">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card">
    <div class="field">
      <label for="etitle"><%= t('title') %> *</label>
      <input type="text" id="etitle" name="title" value="<%= event.title %>" required autofocus
             placeholder="e.g. Evening Aarti">
    </div>

    <div class="formgrid">
      <div class="field">
        <label for="event_date"><%= t('date') %></label>
        <input type="date" id="event_date" name="event_date" value="<%= event.event_date %>">
      </div>
      <div class="field">
        <label for="ecategory"><%= t('category') %></label>
        <select id="ecategory" name="category">
          <% categories.forEach(function(c){ %>
            <option value="<%= c %>" <%= event.category === c ? 'selected' : '' %>><%= c %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="formgrid">
      <div class="field">
        <label for="start_time"><%= t('start_time') %></label>
        <input type="time" id="start_time" name="start_time" value="<%= event.start_time %>">
      </div>
      <div class="field">
        <label for="end_time"><%= t('end_time') %></label>
        <input type="time" id="end_time" name="end_time" value="<%= event.end_time %>">
      </div>
    </div>

    <div class="formgrid">
      <div class="field">
        <label for="place"><%= t('place') %></label>
        <input type="text" id="place" name="place" value="<%= event.place %>">
      </div>
      <div class="field">
        <label for="incharge"><%= t('incharge') %></label>
        <input type="text" id="incharge" name="incharge" value="<%= event.incharge %>">
      </div>
    </div>

    <div class="field">
      <label for="description"><%= t('description') %></label>
      <textarea id="description" name="description" style="min-height:90px"><%= event.description %></textarea>
    </div>

    <label class="check <%= event.is_public ? 'check--on' : '' %>">
      <input type="checkbox" name="is_public" value="1" <%= event.is_public ? 'checked' : '' %>>
      <span><%= t('show_on_public') %></span>
    </label>

    <div class="btnrow mt-2">
      <button class="btn btn--primary btn--lg" type="submit">💾 <%= t('save') %></button>
      <a class="btn btn--ghost" href="/schedule"><%= t('cancel') %></a>
    </div>
  </div>
</form>

<% if (event.id) { %>
  <form class="container-narrow" method="post" action="/schedule/<%= event.id %>/delete"
        data-confirm="<%= t('confirm_delete') %>" data-no-lock>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn--danger btn--sm" type="submit">🗑 <%= t('delete') %></button>
  </form>
<% } %>

<%- include('../partials/footer') %>
