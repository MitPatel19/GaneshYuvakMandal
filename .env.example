# ------------------------------------------------------------------
#  Ganpati Mahotsav Manager — environment variables
#  Copy to .env for local development. On Railway, add these under
#  your service → Variables.
# ------------------------------------------------------------------

# Where the database and uploaded photos are stored.
# LOCAL: leave empty (uses ./data)
# RAILWAY: attach a Volume, then set this to the volume's mount path.
DATA_DIR=/data

# Login for the first admin user. Created automatically on first start.
# CHANGE THE PASSWORD before you share the link with anyone.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-something-strong

# Signs the login cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Set to production on Railway (enables secure cookies).
NODE_ENV=production

# Largest photo that can be uploaded, in megabytes.
MAX_UPLOAD_MB=6

# Only needed if your mandal is NOT in India. Minutes offset from UTC, used to
# decide what counts as "today". Leave unset for IST (+5:30).
# TZ_OFFSET_MINUTES=330

# Railway sets PORT automatically — do not set it yourself there.
# PORT=3000
